# engines/stage-tamagotchi-godot
# Godot 4+ specific ignores
/engines/stage-tamagotchi-godot/**/.godot/
/engines/stage-tamagotchi-godot/android/
/engines/stage-tamagotchi-godot/artifacts/

# .NET build artifacts
/engines/stage-tamagotchi-godot/**/bin/
/engines/stage-tamagotchi-godot/**/obj/

# Godot can scan verification test sources during project imports; these are not stage resources.
/engines/stage-tamagotchi-godot/tests/**/*.uid

