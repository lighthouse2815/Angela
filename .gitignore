/engines/stage-tamagotchi-godot/assets/fixtures/vrm/*
!/engines/stage-tamagotchi-godot/assets/fixtures/vrm/.gitkeep

# integrations/minecraft
/integrations/minecraft/**/logs/

# integrations/satori-bot
