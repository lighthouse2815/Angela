{
  "name": "@angela/voice-client",
  "type": "module",
  "version": "0.12.0-beta.5",
  "private": true,
  "description": "Local voice capture and playback",
  "license": "MIT",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@angela/i18n": "workspace:^",
    "@angela/pipelines-audio": "workspace:^",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/ws": "catalog:"
  }
}
