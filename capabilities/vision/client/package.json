{
  "name": "@angela/vision",
  "type": "module",
  "version": "0.12.0-beta.5",
  "private": true,
  "description": "Local camera and face observation",
  "license": "MIT",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "files": [
    "README.md",
    "dist",
    "python/camera-worker/README.md",
    "python/camera-worker/pyproject.toml",
    "python/camera-worker/uv.lock",
    "python/camera-worker/worker.py"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@angela/core-agent": "workspace:^",
    "@angela/i18n": "workspace:^",
    "@angela/provider-inference": "workspace:^",
    "@moeru/eventa": "catalog:",
    "@xsai/shared-chat": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@angela/companion": "workspace:^"
  }
}
