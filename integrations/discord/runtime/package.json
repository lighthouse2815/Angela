{
  "name": "@angela/discord-companion",
  "type": "module",
  "version": "0.12.0-beta.5",
  "private": true,
  "description": "Discord companion runtime adapter",
  "license": "MIT",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@angela/companion": "workspace:^",
    "@angela/core-agent": "workspace:^",
    "@angela/discord-bot": "workspace:*",
    "@angela/host-sdk": "workspace:^",
    "@angela/i18n": "workspace:^",
    "@angela/provider-inference": "workspace:^"
  }
}
