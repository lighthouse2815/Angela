{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "@angela/gateway#build": {
      "inputs": ["$TURBO_DEFAULT$", "vendor/**", "!vendor/node_modules/**", "!vendor/.next/**", "!README.md", "!UPSTREAM.md", "!vendor/README.angela.md", "!vendor/tests/**"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "@angela/electron-vueuse#build": {
      "dependsOn": ["@angela/electron-eventa#build"],
      "outputs": ["dist/**"]
    }
  }
}
