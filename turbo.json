{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "@angela/electron-vueuse#build": {
      "dependsOn": ["@angela/electron-eventa#build"],
      "outputs": ["dist/**"]
    }
  }
}
