# Any OpenAI-compatible server works: llama.cpp, Ollama, LM Studio, or a cloud API.
ANGELA_LLM_BASE_URL=http://127.0.0.1:8080/v1
ANGELA_LLM_MODEL=qwen3-4b-instruct-2507
ANGELA_LLM_API_KEY=
ANGELA_LLM_TIMEOUT_SECONDS=180

# Keep this small on an 8 GB machine. Durable memory lives in SQLite instead.
ANGELA_CONTEXT_MESSAGES=10
ANGELA_MEMORY_LIMIT=3

ANGELA_HOST=127.0.0.1
ANGELA_PORT=8765
