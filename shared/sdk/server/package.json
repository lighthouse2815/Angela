{
  "name": "@angela/server-sdk",
  "type": "module",
  "version": "0.12.0-beta.5",
  "description": "Client-side SDK for connecting to Angela server components and runtimes",
  "author": {
    "name": "lighthouse2815",
    "url": "https://github.com/lighthouse2815"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lighthouse2815/Angela.git",
    "directory": "shared/sdk/server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utils/node": {
      "types": "./dist/utils/node/index.d.mts",
      "default": "./dist/utils/node/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@angela/better-ws": "workspace:^",
    "@angela/server-shared": "workspace:^",
    "@moeru/std": "catalog:",
    "superjson": "catalog:",
    "valibot": "catalog:"
  }
}
