{
  "name": "@angela/root",
  "type": "module",
  "version": "0.12.0-beta.5",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Angela — AI companion for conversation and learning",
  "author": {
    "name": "lighthouse2815"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lighthouse2815/Angela.git"
  },
  "scripts": {
    "package:cli": "node scripts/package-cli.mjs",
    "cli": "node --env-file-if-exists=.env.cli.local --import tsx packages/airi-cli/src/bin/run.ts",
    "build:cli": "pnpm -F @angela/cli... build",
    "postinstall": "pnpm exec simple-git-hooks && pnpm run build:packages",
    "dev": "pnpm run dev:tamagotchi",
    "dev:ui": "pnpm -rF @angela/stage-ui run story:dev",
    "dev:web": "pnpm -rF @angela/web run dev",
    "dev:web:https": "pnpm -rF @angela/web run dev:https",
    "dev:server": "pnpm -rF @angela/server-runtime run dev",
    "dev:tamagotchi": "pnpm -rF @angela/desktop run dev",
    "dev:tamagotchi:xwayland": "pnpm -rF @angela/desktop run dev:xwayland",
    "dev:apps": "pnpm -rF=\"./apps/*\" run --parallel dev",
    "dev:packages": "pnpm -rF=\"./packages/*\" --parallel run dev",
    "build": "turbo run build -F=\"./packages/*\" -F=\"./apps/*\" -F=\"./server/**\"",
    "build:web": "turbo run build -F @angela/web",
    "build:tamagotchi": "pnpm -rF @angela/desktop run app:build",
    "build:apps": "turbo run build -F=\"./apps/*\"",
    "build:packages": "turbo run build -F=\"./packages/*\"",
    "build:engines": "turbo run build -F=\"./engines/*\"",
    "test": "vitest --coverage",
    "test:run": "vitest run && pnpm run test-stage-tamagotchi:run && pnpm run test-stage-web:run && pnpm run test-stage-pages:run && pnpm run test-ui:run && pnpm run test-stage-ui-live2d:run",
    "test-stage-pages:run": "pnpm -F @angela/stage-pages test:run",
    "test-stage-web:run": "pnpm -F @angela/web exec vitest run --project browser src/pages/devtools/vrm-model-position.browser.test.ts",
    "test-stage-tamagotchi:run": "vitest run --config apps/stage-tamagotchi/vitest.config.ts --project browser",
    "test-ui:run": "vitest run --config packages/stage-ui/vitest.config.ts",
    "test-stage-ui-live2d:run": "vitest run --config packages/stage-ui-live2d/vitest.config.ts --project browser",
    "lint": "moeru-lint .",
    "lint:fix": "moeru-lint --fix .",
    "capture:tamagotchi": "pnpm exec vishot capture --target electron ./packages/scenarios-stage-tamagotchi-electron/src/scenarios/demo-controls-settings-chat-websocket/index.ts --app-entrypoint ./apps/stage-tamagotchi/out/main/index.js --cwd . --output-dir ./packages/scenarios-stage-tamagotchi-browser/artifacts/raw --format avif",
    "sponsors:generate": "sponsorkit --output-dir docs/assets/sponsors",
    "typecheck": "turbo run typecheck -F=\"./packages/*\" -F=\"./apps/*\" -F=\"./server/**\" -F=\"./services/*\"",
    "typecheck:engines": "pnpm -rF=\"./engines/*\" --parallel typecheck",
    "up": "taze -w -r -I && pnpm prune && pnpm dedupe",
    "nolyfill": "pnpm dlx nolyfill",
    "knip": "knip"
  },
  "devDependencies": {
    "@alint-js/cli": "catalog:",
    "@alint-js/plugin-js": "catalog:",
    "@antfu/eslint-config": "catalog:",
    "@arethetypeswrong/core": "catalog:",
    "@electron-toolkit/eslint-config-ts": "catalog:",
    "@iconify/utils": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@proj-airi/unocss-preset-chromatic": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-mini": "catalog:",
    "@unocss/preset-web-fonts": "catalog:",
    "@vishot/cli": "catalog:",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-v8": "catalog:vitest",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "knip": "catalog:",
    "nano-staged": "catalog:",
    "oxc-minify": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "rollup": "catalog:",
    "simple-git-hooks": "catalog:",
    "sponsorkit": "catalog:",
    "sponsors-svg": "catalog:",
    "taze": "catalog:",
    "tinyexec": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "uncrypto": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-scrollbar": "catalog:",
    "unplugin-lightningcss": "catalog:",
    "unplugin-raw": "catalog:",
    "unplugin-unused": "catalog:",
    "vite": "catalog:",
    "vite-plugin-inspect": "catalog:",
    "vitest": "catalog:vitest",
    "vitest-browser-vue": "catalog:",
    "yaml": "catalog:"
  },
  "workspaces": [
    "packages/**",
    "plugins/**",
    "integrations/**",
    "services/**",
    "examples/**",
    "engines/**",
    "apps/**",
    "server/**"
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "moeru-lint --fix"
  }
}
