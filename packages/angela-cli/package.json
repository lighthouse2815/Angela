{
  "name": "@angela/cli",
  "type": "module",
  "version": "0.12.0-beta.5",
  "private": true,
  "description": "Terminal chat and MCP client for Angela",
  "license": "MIT",
  "bin": {
    "angela": "./dist/bin/run.mjs"
  },
  "files": [
    "README.md",
    "dist",
    "python/camera-worker/README.md",
    "python/camera-worker/pyproject.toml",
    "python/camera-worker/uv.lock",
    "python/camera-worker/worker.py"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/bin/run.ts",
