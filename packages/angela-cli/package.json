    "@angela/discord-bot": "workspace:*",
    "@angela/gateway": "workspace:^",
    "@angela/i18n": "workspace:^",
    "@angela/local-config": "workspace:^",
    "@angela/pipelines-audio": "workspace:^",
    "@angela/provider-inference": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "@moeru/eventa": "catalog:",
    "@moeru/std": "catalog:",
    "@xsai/shared": "catalog:",
    "@xsai/shared-chat": "catalog:",
    "abort-controller": "catalog:",
    "grammy": "catalog:",
    "valibot": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:",
    "zca-js": "catalog:"
  },
  "devDependencies": {
    "@types/ws": "catalog:"
  }
