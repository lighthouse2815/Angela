{
  "name": "@angela/server-shared",
  "type": "module",
  "version": "0.12.0-beta.5",
  "description": "Shared types and utilities for Angela server components and runtimes",
  "author": {
    "name": "lighthouse2815",
    "url": "https://github.com/lighthouse2815"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lighthouse2815/Angela.git",
    "directory": "packages/server-shared"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/types/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@angela/plugin-protocol": "workspace:*"
  }
}
