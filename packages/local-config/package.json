{
  "name": "@angela/local-config",
  "type": "module",
  "version": "0.12.0-beta.5",
  "private": true,
  "description": "Shared local provider configuration for Angela applications",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@angela/provider-inference": "workspace:^",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:"
  }
}
